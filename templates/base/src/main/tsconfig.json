{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "typeRoots": ["../../node_modules/@figma"],
    "types": ["plugin-typings"]
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
