{
  "name": "@tode-sdk/create",
  "version": "0.1.0",
  "description": "Scaffold a Figma plugin with tode analytics wired in: React, Vue, Svelte or vanilla TS, Vite or esbuild",
  "type": "module",
  "bin": { "create-tode-plugin": "dist/index.js" },
  "files": ["dist", "templates", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist templates && tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": { "@clack/prompts": "^1.8.0" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.7.0", "vitest": "^5.0.0" },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/kolebayev/create-tode-plugin.git" },
  "keywords": ["figma", "figma-plugin", "template", "create", "tode", "analytics"],
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
